# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=rbac_user
POSTGRES_PASSWORD=rbac_secret
POSTGRES_DB=rbac_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5435

# ─── JWT ──────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=SUPER_SECRET_JWT_KEY
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ─── Cookie ───────────────────────────────────────────────────
COOKIE_NAME=access_token
# Set to true in production (requires HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ─── Seeded Super Admin (created at server start if not exists) ─
SEED_SUPER_ADMIN_FIRST_NAME=Super
SEED_SUPER_ADMIN_LAST_NAME=Admin
SEED_SUPER_ADMIN_EMAIL=superadmin@example.com
SEED_SUPER_ADMIN_PASSWORD=SuperAdmin@123